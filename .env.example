# Optional. Leave empty to use the local /api proxy during development.
VITE_API_BASE_URL=

# Optional. Use "api" to call the local AI Gateway through the /ai proxy. Defaults to "mock".
VITE_AI_PLANNER_MODE=mock

# Required to render the Planner map. Use a public Mapbox access token.
VITE_MAPBOX_ACCESS_TOKEN=

# Optional. Leave empty to derive /project from VITE_API_BASE_URL or use the local proxy.
VITE_SIGNALR_HUB_URL=
