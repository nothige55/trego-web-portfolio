    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "shadcn": "^4.15.0",
